// Tenvio V1 data model.
//
// Every business-owned row carries a businessId and every query in the app
// must be scoped by the logged-in user's businessId — see src/lib/auth.ts
// (requireSession) and the comment block at the top of src/actions/*.ts.
// This file is the single source of truth for tenant isolation: if a model
// holds data that belongs to one business, it MUST have a businessId column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum OfferSource {
  LOYALTY_REWARD
  CAMPAIGN_PROMO
  MANUAL         // Phase M — owner sent this reward by hand
  CHALLENGE      // Phase N — awarded for completing a challenge
}

enum MessageType {
  WELCOME
  LOYALTY_ONE_AWAY
  REWARD_UNLOCKED
  CAMPAIGN
}

enum MessageStatus {
  SENT       // accepted by Twilio (or dev-mode simulated — see simulated flag)
  DELIVERED  // confirmed delivered via Twilio status callback (not wired in V1, reserved)
  FAILED
}

enum CampaignStatus {
  DRAFT
  SENT
}

// --- Billing / subscription lifecycle -------------------------------------
//
// SubscriptionStatus is the lifecycle state (what's actually happening with
// billing) — deliberately kept to exactly the states that drive different
// behavior, nothing redundant:
//   TRIAL      — no Stripe subscription exists yet; trialEndsAt is authoritative.
//   ACTIVE     — a real Stripe subscription, in good standing.
//   PAST_DUE   — Stripe is retrying a failed payment (Smart Retries). We do
//                NOT run our own dunning/grace-period timer — see the
//                Subscription model comment.
//   CANCELING  — active subscription with cancelAtPeriodEnd=true. Written by
//                exactly one place (the Stripe webhook handler, or the
//                cancel action) from a single Stripe payload, never derived
//                independently elsewhere, so it can never drift out of sync
//                with cancelAtPeriodEnd.
//   CANCELED   — subscription has actually ended.
//   COMPED     — full access granted by a Tenvio admin, no Stripe object
//                required at all (see compedReason/compedByAdminId/compedUntil).
//
// This is a distinct axis from product ACCESS (FULL vs RESTRICTED), which is
// derived from this status (plus trialEndsAt/compedUntil/currentPeriodEnd)
// by a single centralized guard — see lib/access.ts (Phase B). Nothing
// outside that guard should branch on SubscriptionStatus directly.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELING
  CANCELED
  COMPED
}

// How a TRIAL subscription's free period was granted — distinguishes the
// default self-service trial from one a Tenvio admin set up by hand (a
// founder-led pilot), purely for admin-side reporting/context.
enum TrialSource {
  SELF_SERVICE
  FOUNDER_GRANT
}

// A Plan's billing cadence. Only MONTH ships in V1 — see Plan model comment
// — but Subscription/display code should read this rather than hardcode
// "/month" anywhere, so adding a YEAR plan later doesn't require touching
// unrelated display logic.
enum PlanInterval {
  MONTH
  YEAR
}

enum CancellationReason {
  TOO_EXPENSIVE
  NOT_USING_ENOUGH
  MISSING_FEATURE
  DIFFICULT_TO_USE
  SWITCHING
  CLOSING_BUSINESS
  TECHNICAL_PROBLEMS
  DIDNT_SEE_VALUE
  TEMPORARY_SEASONAL
  OTHER
}

enum CancellationInitiator {
  MERCHANT
  ADMIN
}

// How a business measures loyalty progress. PER_SPEND is reserved but not
// yet implemented anywhere (no UI, no logic reads it) — Tenvio has no
// POS/order data source to know how much a customer spent, so building
// spend-based earning now would be UI without real data behind it. Added to
// the enum now purely so a future POS integration doesn't need its own
// migration just to add this value.
enum LoyaltyEarningMode {
  PER_VISIT  // one loyalty unit per interaction, regardless of quantity
  PER_UNIT   // loyalty units = quantity of qualifying items/services
  PER_SPEND  // reserved, not implemented
}

// Phase L. Drives merchant-facing TERMINOLOGY ONLY — never behavior. The
// loyalty engine, scanning, rewards, and campaigns are identical across
// every industry; this only decides whether staff see "Log Purchase",
// "Log Visit", or "Log Check-in", and whether people are called customers,
// clients, or members. See src/lib/terminology.ts, the single place these
// labels are resolved. Deliberately NOT branched on anywhere in
// purchase-actions/loyalty logic — the moment industry changes behavior,
// Tenvio becomes three products instead of one (CLAUDE.md section 5).
enum Industry {
  FOOD_BEVERAGE
  BEAUTY
  FITNESS
  OTHER
}

// Phase M. What a reward actually gives the customer. FREE_ITEM is the
// V1 behavior and stays the default so every existing Offer keeps its
// meaning. `rewardValue` carries the number for the types that need one
// (cents for DOLLAR_DISCOUNT, whole percent for PERCENT_DISCOUNT) and is
// null for the rest — see the Offer model.
enum RewardType {
  FREE_ITEM
  FREE_SERVICE
  FREE_CLASS
  DOLLAR_DISCOUNT
  PERCENT_DISCOUNT
  GUEST_PASS
  CUSTOM
}

// Phase M. Why a reward was issued by hand, for merchant reporting. Only
// set on manually-sent rewards; loyalty/campaign offers leave it null.
enum ManualRewardReason {
  BIRTHDAY
  APPRECIATION
  SERVICE_RECOVERY
  PROMOTION
  REFERRAL
  OTHER
}

model Business {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  location   String?
  createdAt  DateTime @default(now())

  // Phase L — presentation only, see the Industry enum comment. Defaults to
  // FOOD_BEVERAGE so every business that existed before this column keeps
  // the exact wording it already had.
  industry   Industry @default(FOOD_BEVERAGE)

  // V1 sends every business's texts from ONE shared Twilio number
  // (TWILIO_PHONE_NUMBER env var) — this column exists so a future version
  // can give each business its own dedicated number without a schema change.
  // Important consequence while it's null/shared: the inbound STOP/START
  // webhook (src/app/api/webhooks/twilio/route.ts) can't tell which business
  // a reply was "meant for" on a shared number, so it opts a phone number out
  // GLOBALLY across every business rather than guessing — see that file's
  // comment for the full reasoning. Once businesses have dedicated numbers,
  // the webhook should switch to scoping by this field instead.
  twilioFromNumber String?

  // Messaging preferences — owner-controlled, per your "never send without
  // the owner knowing" requirement. Each trigger has its own toggle.
  welcomeSmsEnabled  Boolean @default(true)
  oneAwaySmsEnabled  Boolean @default(true)
  rewardSmsEnabled   Boolean @default(true)

  users          User[]
  loyaltyProgram LoyaltyProgram?
  customers      Customer[]
  purchases      Purchase[]
  offers         Offer[]
  campaigns      Campaign[]
  messages       Message[]
  subscription   Subscription?
  cancellations  Cancellation[]
  adminAuditLogs AdminAuditLog[]
  challenges     Challenge[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())

  purchasesLogged   Purchase[]
  offersRedeemed    OfferRedemption[]

  @@index([businessId])
}

model LoyaltyProgram {
  id                String             @id @default(cuid())
  businessId        String             @unique
  business          Business           @relation(fields: [businessId], references: [id])
  purchasesRequired Int                @default(10)
  rewardDescription String             @default("Free Coffee")
  // Default PER_VISIT preserves today's behavior for every existing
  // business — this is an opt-in, not a retroactive change.
  earningMode       LoyaltyEarningMode @default(PER_VISIT)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])

  phoneNumber   String   // normalized E.164-ish, e.g. +15551234567
  firstName     String?
  birthdayMonth Int?     // 1-12, optional, month/day only — no birth year stored
  birthdayDay   Int?     // 1-31

  signupAt      DateTime  @default(now())
  lastVisitAt   DateTime?
  totalVisits   Int       @default(0)

  // Long opaque random string, permanently tied to this one customer, encoded
  // into their personal "loyalty card" QR (see /c/[token] and
  // src/lib/customer-card.ts). Unlike Offer.token (single-use, one per
  // reward), this token lives for the customer's whole relationship with the
  // business and is what staff scan at checkout to log a purchase — scanning
  // it never runs the balance-changing logic directly; it's just how the
  // scanner finds the right Customer row, and the actual purchase-adding
  // action still requires an authenticated staff session (see
  // logPurchaseByTokenAction in src/actions/purchase-actions.ts). Nullable so
  // existing rows created before this feature don't need a backfill
  // migration — it's generated lazily the first time it's needed.
  qrToken       String?   @unique

  // Loyalty progress toward the CURRENT reward cycle. Resets to 0 when a
  // reward is earned (see logPurchase in src/actions/purchase-actions.ts).
  loyaltyCount     Int       @default(0)
  lifetimeRewards  Int       @default(0)

  // Guards against sending the "one away" text more than once per cycle.
  // Set when the text goes out; cleared whenever loyaltyCount resets.
  oneAwayNotifiedAt DateTime?

  consent            CustomerConsent?
  purchases          Purchase[]
  offers             Offer[]
  campaignRecipients CampaignRecipient[]
  messages           Message[]
  challengeProgress  ChallengeProgress[]

  @@unique([businessId, phoneNumber])
  @@index([businessId])
}

model CustomerConsent {
  id           String    @id @default(cuid())
  customerId   String    @unique
  customer     Customer  @relation(fields: [customerId], references: [id])
  optedInAt    DateTime  @default(now())
  optInMethod  String    @default("qr_signup")
  optedOutAt   DateTime?
  optOutMethod String?
}

model Purchase {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  loggedByUserId String?
  loggedByUser   User?    @relation(fields: [loggedByUserId], references: [id])
  createdAt      DateTime @default(now())

  // Loyalty units this interaction is worth. Always 1 under PER_VISIT
  // (quantity is irrelevant there); under PER_UNIT it's however many
  // qualifying items/services staff selected — one Purchase row per scan,
  // never one row per unit, so "scan once, quantity 3" never triple-scans.
  quantity       Int      @default(1)

  // Client-generated per-scan-attempt key (see log-purchase-scan-panel.tsx).
  // A retried/double-submitted request with the same key is a no-op instead
  // of creating a second row — see createPurchaseByTokenAction.
  idempotencyKey String?  @unique

  // Deferred-SMS reversal window (see purchase-actions.ts). Undo is only
  // allowed while finalizedAt is still null; once the SMS decision has been
  // finalized, the interaction is permanent. voidedAt marks a reversed
  // Purchase rather than deleting it, so it stays visible for support/audit
  // — counts and stats must filter WHERE voidedAt IS NULL.
  finalizedAt    DateTime?
  voidedAt       DateTime?

  // What this interaction's outcome was, captured at creation time so
  // finalizePurchaseAction/undoPurchaseAction don't have to re-derive it
  // later (which would be fragile — e.g. a later purchase could also
  // trigger a reward, making "the most recent reward offer" ambiguous).
  // Deliberately a plain scalar, not a Prisma relation back to Offer — this
  // is internal plumbing for the finalize/undo pair, never queried from UI.
  wasOneAway          Boolean  @default(false)
  rewardOfferId       String?

  // Exact Customer counter snapshot immediately before this purchase was
  // applied — undoPurchaseAction restores these verbatim rather than trying
  // to recompute "what it must have been," which breaks the moment quantity
  // overshoots a threshold (the discarded excess makes the reverse
  // calculation ambiguous). Defaulted rather than nullable so the existing-
  // row backfill in this migration (finalizedAt = createdAt) doesn't need a
  // second migration to add NOT NULL columns — pre-migration rows are never
  // undoable anyway (see the backfill), so their snapshot values are unused.
  loyaltyCountBefore      Int       @default(0)
  totalVisitsBefore       Int       @default(0)
  lifetimeRewardsBefore   Int       @default(0)
  oneAwayNotifiedAtBefore DateTime?

  @@index([businessId])
  @@index([customerId])
}

// A single redeemable thing — either a loyalty reward earned by hitting the
// program threshold, or a promo created by a campaign. Both share one
// redemption mechanism (see src/lib/redemption.ts and the /redeem screen)
// rather than duplicating the same logic across two separate table pairs.
model Offer {
  id          String      @id @default(cuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id])
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  campaignId  String?
  campaign    Campaign?   @relation(fields: [campaignId], references: [id])

  source      OfferSource
  description String      // e.g. "Free Coffee" or "$1 Off Any Latte"

  // Phase M. `description` stays the human string shown everywhere (and
  // remains the source of truth for display); these add machine-readable
  // structure so the Rewards Wallet can render a reward consistently and
  // future reporting can group by type. FREE_ITEM default keeps every
  // pre-existing Offer meaning exactly what it did before.
  rewardType  RewardType  @default(FREE_ITEM)
  // Cents for DOLLAR_DISCOUNT, whole percent for PERCENT_DISCOUNT, null for
  // every other type. Deliberately one nullable Int rather than two columns
  // — a reward is never both a dollar and a percent discount.
  rewardValue Int?

  // Set only when an owner sends a reward by hand (Phase M "Send Reward"),
  // for merchant-side reporting on why comps go out. Null for loyalty and
  // campaign offers, which already carry that meaning in `source`.
  manualReason ManualRewardReason?

  // Long opaque random string, encoded into the QR / redemption link.
  token       String      @unique
  // Short numeric fallback for manual entry at the register.
  shortCode   String

  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  // Set when the Purchase that earned this reward is undone within its
  // finalize window (see purchase-actions.ts undoPurchaseAction) — a voided
  // reward Offer must never be redeemable. Not used for CAMPAIGN_PROMO
  // offers, which have no undo path.
  voidedAt    DateTime?

  redemption  OfferRedemption?

  @@unique([businessId, shortCode])
  @@index([businessId])
  @@index([customerId])
}

// Phase N. A time-boxed goal ("complete 12 classes in August, get one
// free") that runs ALONGSIDE the normal loyalty program rather than
// replacing it — a single logged activity advances both, independently.
// Deliberately generic: the engine counts qualifying activities, and the
// industry only changes what those are called (see the Industry enum).
model Challenge {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])

  name        String   // "August Pilates Challenge"
  description String?
  // How many qualifying activities complete the challenge.
  targetCount Int
  // What they get. Same free-text shape as LoyaltyProgram.rewardDescription
  // so the reward Offer it issues reads identically to a loyalty one.
  rewardDescription String
  rewardType  RewardType @default(FREE_ITEM)

  // A challenge only counts activity logged inside its window. endsAt is
  // required — an open-ended "challenge" is just the loyalty program, and
  // the whole point of this feature is the deadline creating urgency.
  startsAt    DateTime
  endsAt      DateTime

  // Lets an owner stop a challenge early without deleting its history.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  progress    ChallengeProgress[]

  @@index([businessId])
}

// One row per customer per challenge, created lazily the first time that
// customer logs a qualifying activity while the challenge is running.
model ChallengeProgress {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])

  count       Int       @default(0)
  // Set once when count first reaches targetCount, and never recomputed —
  // it's what stops a completed challenge from issuing a second reward if
  // the customer keeps logging activity before the window closes.
  completedAt DateTime?
  // The reward Offer issued on completion, so it's traceable back here.
  rewardOfferId String?

  updatedAt   DateTime  @updatedAt

  // DB-level guarantee of one progress row per customer per challenge —
  // the same guarantee OfferRedemption.offerId gives redemptions, and it's
  // what makes the concurrent-scan upsert safe.
  @@unique([challengeId, customerId])
  @@index([customerId])
}

model OfferRedemption {
  id               String   @id @default(cuid())
  offerId          String   @unique // DB-level guarantee: at most one redemption per offer
  offer            Offer    @relation(fields: [offerId], references: [id])
  redeemedAt       DateTime @default(now())
  redeemedByUserId String?
  redeemedByUser   User?    @relation(fields: [redeemedByUserId], references: [id])
}

model Campaign {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id])
  name        String
  offerDescription String?   // e.g. "$1 Off Any Latte" — null means no redeemable offer, just an SMS
  messageBody String
  status      CampaignStatus @default(DRAFT)
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  recipients  CampaignRecipient[]
  offers      Offer[]
  messages    Message[]

  @@index([businessId])
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  sentAt     DateTime @default(now())

  @@unique([campaignId, customerId])
  @@index([campaignId])
}

model Message {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id])
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  campaignId String?
  campaign   Campaign?     @relation(fields: [campaignId], references: [id])

  type       MessageType
  body       String
  status     MessageStatus @default(SENT)
  simulated  Boolean       @default(false) // true = dev-mode, no Twilio configured
  twilioSid  String?
  createdAt  DateTime      @default(now())

  @@index([businessId])
  @@index([customerId])
}

// A Plan is a distinct, named offer at a distinct Stripe Price — NOT a
// mirror of every field Stripe already owns. Stripe Prices are immutable by
// design (you create a new Price to change pricing, never mutate an old
// one), which is exactly the grandfathering primitive this table leans on:
// a business's Subscription.planId points at whichever Plan/Price it
// actually checked out under, and changing which Plan is `active` for NEW
// signups never touches existing subscriptions.
//
// amountCents/currency/interval are a CACHED display copy for admin UI and
// MRR math — Stripe remains the source of truth for what's actually
// charged. Named `amountCents` (not `monthlyAmountCents`) because `interval`
// is what determines monthly vs. annual, not the field name.
model Plan {
  id            String       @id @default(cuid())
  key           String       @unique // "founding" | "standard" | ...
  name          String                // "Tenvio Founding"
  stripePriceId String?      @unique
  amountCents   Int
  currency      String       @default("usd")
  interval      PlanInterval @default(MONTH)
  active        Boolean      @default(true) // offered to new self-service signups?
  // Default trial length offered to a self-service signup on this Plan —
  // Admin-configurable (Phase G) so changing it is an UPDATE, not a
  // deploy. See src/lib/plans.ts getActivePlan(), the one place this is
  // read from.
  trialDays     Int          @default(14)
  createdAt     DateTime     @default(now())

  subscriptions Subscription[]
}
model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id])

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIAL)

  // Null until a real Stripe Checkout completes — see TRIAL comment above
  // and the SubscriptionStatus enum comment. Once set, Stripe is
  // authoritative for this subscription's lifecycle; these mirror what the
  // most recent webhook told us, they are not independently computed.
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // --- Local trial (no Stripe object involved at all) ---
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  trialSource    TrialSource?
  // Which Tenvio admin granted/extended a founder-led trial, for context —
  // null for the default self-service trial. Nullable FK: an AdminUser can
  // be removed later without breaking historical Subscription rows.
  trialGrantedByAdminId String?
  trialGrantedByAdmin   AdminUser? @relation("SubscriptionTrialGrantedBy", fields: [trialGrantedByAdminId], references: [id])

  // --- Cancellation, mirrored from Stripe ---
  // cancelAtPeriodEnd + currentPeriodEnd are the raw Stripe attributes;
  // status=CANCELING is the derived lifecycle label written from the same
  // webhook payload (see SubscriptionStatus comment) — never set elsewhere.
  cancelAtPeriodEnd Boolean   @default(false)
  currentPeriodEnd  DateTime?
  canceledAt        DateTime?

  // --- Comp (full access, no Stripe subscription, no charge) ---
  compedReason    String?
  compedByAdminId String?
  compedByAdmin   AdminUser? @relation("SubscriptionCompedBy", fields: [compedByAdminId], references: [id])
  compedAt        DateTime?
  compedUntil     DateTime? // null = indefinite

  // --- Admin-forced lockout, independent of billing state ---
  // For abuse, a payment dispute outside Stripe's normal flow, or any other
  // reason Tenvio staff need to cut off an otherwise-paying account without
  // touching Stripe. deriveAccess() (src/lib/access.ts) checks this FIRST,
  // before any status/date logic — set it and access is RESTRICTED
  // regardless of what status/trialEndsAt/etc. say. Reactivating is just
  // clearing this field; the "when/why/who" history lives in
  // AdminAuditLog, not here — same split as the comp fields above.
  adminRestrictedAt       DateTime?
  adminRestrictedReason   String?
  adminRestrictedByAdminId String?
  adminRestrictedByAdmin   AdminUser? @relation("SubscriptionAdminRestrictedBy", fields: [adminRestrictedByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cancellations Cancellation[]
}

// A completely separate authentication surface from merchant Users — see
// lib/admin-auth.ts (Phase B/E) and the architecture report's §63 tradeoff
// discussion. Deliberately minimal: no roles/permission tiers, no teams, no
// SSO — everyone in this table is a full Tenvio operator. Rows are
// provisioned by hand (seed/direct insert), never via self-service signup.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  grantedTrials         Subscription[]  @relation("SubscriptionTrialGrantedBy")
  compedSubscriptions   Subscription[]  @relation("SubscriptionCompedBy")
  restrictedSubscriptions Subscription[] @relation("SubscriptionAdminRestrictedBy")
  auditLogs             AdminAuditLog[]
}
// A record of a sensitive admin action — trial extended, account comped,
// restricted, terminated, subscription canceled, etc. `action` is a plain
// string constant (not an enum) deliberately: new action types should never
// require a schema migration, unlike SubscriptionStatus which genuinely
// needs to be a closed, compiler-checked set because access logic branches
// on it. `businessId` is nullable because some admin actions are global
// (e.g. deactivating a Plan) rather than about one business.
model AdminAuditLog {
  id         String     @id @default(cuid())
  adminId    String
  admin      AdminUser  @relation(fields: [adminId], references: [id])
  businessId String?
  business   Business?  @relation(fields: [businessId], references: [id])
  action     String
  reason     String?
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([businessId])
  @@index([adminId])
}

// One row per cancellation *request* — including ones later undone, so the
// reason/feedback record is never lost. The "Tenvio Impact" summary shown
// to a cancelling merchant is deliberately NOT stored here: it's computed
// live from Customer/Purchase/Offer/Message counts at render time, since
// those numbers are cheap to query and a stored snapshot would just drift
// out of date (especially across an undo + re-cancel). Only the decision
// itself is a permanent record.
model Cancellation {
  id             String                @id @default(cuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id])
  subscriptionId String
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id])
  requestedAt    DateTime              @default(now())
  effectiveAt    DateTime
  reason         CancellationReason
  feedback       String?
  initiatedBy    CancellationInitiator
  cancelAtPeriodEnd Boolean
  reactivatedAt  DateTime?

  @@index([businessId])
  @@index([subscriptionId])
}

// Idempotency guard for the Stripe webhook handler — insert-or-skip by
// Stripe's own event id BEFORE processing an event body, so a redelivered
// event is a guaranteed no-op instead of relying on handlers happening to
// be overwrites.
model StripeWebhookEvent {
  id          String   @id // the Stripe event id itself, e.g. "evt_..."
  type        String
  processedAt DateTime @default(now())
}
