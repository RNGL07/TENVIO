# --- Core (required) ---

# Postgres connection string. Railway provides this automatically once you add
# a PostgreSQL service to your project — copy it from the Postgres service's
# "Variables" tab, or (recommended) just reference it as ${{Postgres.DATABASE_URL}}
# in the web service's variables so Railway wires it for you.
DATABASE_URL=postgresql://user:password@localhost:5432/tenvio

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The public URL of the deployed app (used to build QR code links and SMS links).
# Locally: http://localhost:3000
# On Railway: your generated domain, e.g. https://tenvio-production.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Twilio (optional — leave blank to run in SMS dev-log mode) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Stripe (optional — leave blank to run in billing dev-active mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
